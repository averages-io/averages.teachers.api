{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The teacher API. No public address on purpose: the averages.teachers Worker forwards
  // teach.averages.io/api/* here through a service binding (its wrangler.jsonc, "services").
  // Deploy this one first.
  "name": "averages-teachers-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Keeps variables changed in the dashboard from being wiped by a deploy.
  "keep_vars": true,
  "vars": {
    "APP_ORIGIN": "https://teach.averages.io",
    "RP_ID": "teach.averages.io"
  },
  // Secrets, set once with `npx wrangler secret put <NAME>`:
  //   SESSION_SECRET             32+ random bytes, e.g. `openssl rand -base64 32`
  //   SCHOOLOGY_CONSUMER_KEY     the App Center app's key (needed from M1, sign-in)
  //   SCHOOLOGY_CONSUMER_SECRET  its secret
  "durable_objects": {
    // One per teacher, created in the US jurisdiction in code (src/passkeys.ts, durableStore).
    "bindings": [{ "name": "TEACHER", "class_name": "TeacherStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TeacherStore"] }],
  "ratelimits": [
    // Passkey routes: adding counts per teacher, signing in per IP.
    { "name": "RATE_LIMIT_PASSKEY", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } }
  ]
}
